digraph plan_first {
  start -> plan_gate
  plan_gate -> planner         [label="ready"]
  plan_gate -> plan_author     [label="not ready"]

  plan_author -> plan_gameplay
  plan_author -> plan_objects
  plan_author -> plan_testability
  plan_author -> plan_terminal
  plan_gameplay -> plan_synthesiser
  plan_objects -> plan_synthesiser
  plan_testability -> plan_synthesiser
  plan_terminal -> plan_synthesiser
  plan_synthesiser -> plan_author [label="not satisfied"]
  plan_synthesiser -> planner     [label="satisfied"]

  planner -> doer              [label="not complete"]
  planner -> finish            [label="complete"]
  doer -> validator
  validator -> planner         [label="satisfied"]
  validator -> doer            [label="retry"]
  validator -> plan_author     [label="replan"]
}
