digraph plan_first {
  start -> plan_gate
  plan_gate -> planner          [label="ready"]
  plan_gate -> plan_author      [label="not ready"]

  plan_author -> plan_reviewer_1
  plan_author -> plan_reviewer_2
  plan_author -> plan_reviewer_3
  plan_reviewer_1 -> plan_synthesiser
  plan_reviewer_2 -> plan_synthesiser
  plan_reviewer_3 -> plan_synthesiser
  plan_synthesiser -> plan_author [label="not satisfied"]
  plan_synthesiser -> planner     [label="satisfied"]

  planner -> doer               [label="not complete"]
  planner -> finish             [label="complete"]

  doer -> validator_objects
  doer -> validator_tests
  doer -> validator_terminal
  validator_objects -> validation_synthesiser
  validator_tests -> validation_synthesiser
  validator_terminal -> validation_synthesiser
  validation_synthesiser -> planner     [label="satisfied"]
  validation_synthesiser -> doer        [label="retry"]
  validation_synthesiser -> plan_author [label="replan"]
}
