{
  "name": "ensembleworks-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": ["@types/jest", "jest"]
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "test": "npm run test:application && npm run test:components",
    "test:application": "tsx --test tests/*.test.ts",
    "test:components": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && expo install --check"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.6",
    "expo-crypto": "58.0.5",
    "expo-dev-client": "58.0.11",
    "expo-system-ui": "58.0.5",
    "livekit-client": "2.22.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.8",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react-native": "$react-native"
  }
}
