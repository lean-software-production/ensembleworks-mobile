{
  "name": "ensembleworks-mobile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "expo start --dev-client",
