    "expo-dev-client": "~6.0.21",
    "expo-system-ui": "~6.0.9",
    "livekit-client": "2.22.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
